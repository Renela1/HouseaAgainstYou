[gd_resource type="Resource" script_class="ContainerData" format=3 uid="uid://efn4w3n20g1w"]

[ext_resource type="Script" uid="uid://cv5u5v5uhrrcn" path="res://containers/container_entry.gd" id="1_entry"]
[ext_resource type="Resource" uid="uid://b1ne08s8nq3v4" path="res://items/definitions/coin.tres" id="2_coin"]
[ext_resource type="Resource" path="res://items/definitions/key.tres" id="3_key"]
[ext_resource type="Script" uid="uid://6i0ppf4pawpe" path="res://interactions/interaction_rule.gd" id="4_rule_script"]
[ext_resource type="Script" uid="uid://bphilts86jgq1" path="res://containers/container_data.gd" id="5_data"]
[ext_resource type="Resource" path="res://containers/definitions/cabinet_key_rule.tres" id="6_rule"]
[ext_resource type="SpriteFrames" path="res://containers/definitions/cabinet_frames.tres" id="7_frames"]

[sub_resource type="Resource" id="Resource_coin"]
script = ExtResource("1_entry")
item = ExtResource("2_coin")
quantity = 3

[sub_resource type="Resource" id="Resource_key"]
script = ExtResource("1_entry")
item = ExtResource("3_key")

[resource]
script = ExtResource("5_data")
id = &"cabinet"
name = "kitchen cabinet"
description = "A locked cabinet. Something rattles inside."
rules = Array[ExtResource("4_rule_script")]([ExtResource("6_rule")])
contents = Array[ExtResource("1_entry")]([SubResource("Resource_coin"), SubResource("Resource_key")])
loot_message = "Found 3 coins and a rusty key."
open_message = "The cabinet creaks open."
close_message = "The cabinet clicks shut."
frames = ExtResource("7_frames")
